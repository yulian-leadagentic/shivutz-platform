# ─── MySQL ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── RabbitMQ ────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SERVICE_JWT_SECRET=change_this_internal_service_secret

# ─── Auth Service ────────────────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_SERVICE_URL=http://auth:3001

# ─── User-Org Service ────────────────────────────────────
ORG_DB_NAME=org_db
USER_ORG_SERVICE_URL=http://user-org:3002

# ─── Worker Service ──────────────────────────────────────
WORKER_DB_NAME=worker_db
WORKER_SERVICE_URL=http://worker:3003

# ─── Deal Service ────────────────────────────────────────
DEAL_DB_NAME=deal_db
DEAL_SERVICE_URL=http://deal:3005

# ─── Notification Service ────────────────────────────────
NOTIF_DB_NAME=notif_db
NOTIFICATION_SERVICE_URL=http://notification:3006
SENDGRID_API_KEY=SG.changeme
SENDGRID_FROM_EMAIL=noreply@shivutz-platform.co.il
SENDGRID_FROM_NAME=Shivutz Platform

# ─── Admin Service ───────────────────────────────────────
ADMIN_SERVICE_URL=http://admin:3007

# ─── Gateway ─────────────────────────────────────────────
GATEWAY_PORT=3000
RATE_LIMIT_ANON=30
RATE_LIMIT_USER=200
RATE_LIMIT_ADMIN=500

# ─── Anthropic (query rewriter + reranker) ──────────────
# Missing key → user-org boots in fake mode (regex/keyword extractor).
# Container logs print `[qrewrite] mode=real ...` or `mode=fake reason=...`
# on startup — grep to confirm. LLM_REWRITER_FAKE_MODE=1 forces fake
# even when the key is set (useful for local dev / test).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_REWRITER_FAKE_MODE=
LLM_REWRITER_TIMEOUT_S=3.0
LLM_RERANK_ENABLED=1
LLM_RERANK_MIN=3
LLM_RERANK_TOP_N=20

# ─── ElevenLabs (voice search STT) ───────────────────────
# Track V — /api/voice/transcribe proxies audio to Scribe.
# Server-side only, NEVER expose to the client. Missing key → 503.
ELEVENLABS_API_KEY=

# ─── Cardcom (payments) ──────────────────────────────────
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
CARDCOM_BASE_URL=https://secure.cardcom.solutions
CARDCOM_TERMINAL_NUMBER=
CARDCOM_WEBHOOK_SECRET=

# ─── Vonage (SMS + WhatsApp) ─────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Shivutz
VONAGE_SIGNATURE_SECRET=
SMS_PROVIDER=vonage

# ─── Payment service ─────────────────────────────────────
PAYMENT_DB_NAME=payment_db
PAYMENT_SERVICE_URL=http://payment:3009
# PAYMENT_FAKE_MODE=1 short-circuits Cardcom for local dev.
PAYMENT_FAKE_MODE=

# L5 §6 — shared secret between the notification cron and the
# payment service's /internal/renewal-batch endpoint. Any value
# set consistently across the two services works; rotate per env.
INTERNAL_BATCH_SECRET=

# L8 §2 — comma-separated allowlist of Origin values the gateway
# will return CORS headers for. EMPTY = permissive mode (echoes
# every Origin). Do NOT set to a wrong list — a bad allowlist looks
# like a total site outage. The real domain is tagidai.com (see
# services/frontend/middleware.ts PROD_HOSTS) — .co.il is a
# different TLD and would silently break every request.
# Prod example:
# CORS_ALLOWED_ORIGINS=https://tagidai.com,https://www.tagidai.com,http://localhost:3008
# Staging example:
# CORS_ALLOWED_ORIGINS=https://staging.tagidai.com,http://localhost:3008
CORS_ALLOWED_ORIGINS=

# L8 §1 — JSON error logger metadata. Filled per environment so a
# single log stream can be filtered by service + release.
ENVIRONMENT=development
RELEASE_SHA=
LOG_LEVEL=INFO

# L8 §1 — Sentry DSN placeholder. Payment / user-org / gateway /
# frontend read this from ENV; if empty, JSON-log alternative from
# app/logging_config.py handles error visibility. NEVER paste a real
# DSN here — this file is committed to git.
SENTRY_DSN=

# ─── Admin bootstrap ─────────────────────────────────────
# Email that seeds the first admin user on migration run.
ADMIN_EMAIL=admin@example.com

# ─── Frontend base URL (SMS/email deep links) ────────────
# R17 · Consumed by services that build cta_url / adminLink /
# invite links for SMS + email:
#   * user-org        (providers.py, contractors.py — welcome/verify)
#   * admin           (users.py — admin invite email)
#   * notification    (handlers.js + every cron in src/cron/*.js)
# Every one of these hardcodes 'https://www.tagidai.com' as its
# default when the env var is missing. Set this on EACH of the three
# services above in Railway; a service that boots without it links
# to the tagidai.com domain (fine now — was 'staging.buildupai.net',
# the legacy staging subdomain of the abandoned domain, before R17
# aligned all four defaults).
# Local docker-compose sets FRONTEND_URL=http://localhost:3008.
FRONTEND_URL=http://localhost:3008

# ─── R10 §0/§4 · non-production email allowlist ──────────
# Comma-separated list of domain suffixes; when NODE_ENV != 'production'
# the notification service refuses to send email to any address whose
# domain is NOT in this list, and logs the block to notification_log
# with status='blocked_by_allowlist'. Default when unset:
# 'example.com,tagidai.com'. Never enforce this in prod — real users
# need real deliveries.
EMAIL_ALLOWLIST_DOMAINS=example.com,tagidai.com

# ─── R19 · Free-launch date (three-way env fanout) ───────
# The launch-promo end date lives in FOUR places and MUST be identical
# across all of them; the --suite core consistency check will fail
# loudly if any one drifts. Yulian's decision-doc §1 authority: any
# change is made in one place first (site_settings.launch_promo_end
# via /admin/legal → Settings) then propagated to the three env vars
# below. To shorten the promo is a broken promise — long value first
# and shorten only if data supports it.
#
# Where each is consumed:
#   * site_settings.launch_promo_end (DB, org_db)
#       → user-org providers.py — decides `price_paid=0` on register
#   * FREE_LAUNCH_UNTIL (payment service)
#       → cardcom.py `_free_launch_active()` — decides whether the
#         actual charge/capture is short-circuited. If site_settings
#         says "free" and this env var is missing, the customer sees
#         "החשבון פעיל בחינם" AND gets charged for real. The bug this
#         gate exists to prevent.
#   * FREE_LAUNCH_UNTIL (notification service)
#       → handlers.js welcome-email copy branch
#   * NEXT_PUBLIC_FREE_LAUNCH_UNTIL (frontend)
#       → components/shared/FreeLaunchBanner.tsx render gate
#         🔴 baked at BUILD time (NEXT_PUBLIC_*). Change requires a
#            fresh frontend deploy, not just a service restart.
#
# All three env vars are exposed via /config/promo (payment,
# notification) and /api/config/promo (frontend) so the smoke test
# reads them without needing Railway API access.
FREE_LAUNCH_UNTIL=2026-12-31
NEXT_PUBLIC_FREE_LAUNCH_UNTIL=2026-12-31

# ─── R19 §3 · Coming-soon gate (production) ──────────────
# COMING_SOON_MODE gates the entire frontend behind a preview key.
# Middleware refuses to render pages until the visitor has a
# `coming_soon_bypass=1` cookie (set by POST /api/coming-soon-bypass
# after posting the preview key). Set 0 on launch day to open the
# site to the public. When unset the middleware behaves as if
# COMING_SOON_MODE=1 (safe default so a mis-configured deploy stays
# closed rather than accidentally launching).
COMING_SOON_MODE=0
COMING_SOON_PREVIEW_KEY=

# ─── R19 §3 · Frontend API base URL (build-time inlined) ──
# The browser hits `${NEXT_PUBLIC_API_URL}/…` for every API call.
# Wrong value in production = every request 404s and the site is
# dark. Baked at build time; change requires a fresh deploy.
# Local docker-compose sets `http://localhost:3000/api` implicitly
# because the frontend container talks to gateway on the compose
# network.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── R19 §3 · SMS providers ──────────────────────────────
# The active provider is picked by SMS_PROVIDER (stub / inforu /
# twilio / vonage). Populating credentials for BOTH inforu and
# twilio is safe — only the one named by SMS_PROVIDER is called.
# Default when SMS_PROVIDER is unset: `stub` (console.log only,
# nothing sent). Real production MUST set SMS_PROVIDER explicitly,
# else OTP codes go into stdout and nobody signs in on launch day.
SMS_PROVIDER=stub
# InfoRu — Israeli SMS provider (Hebrew-aware sender ID)
INFORU_API_KEY=
INFORU_USERNAME=
INFORU_SENDER=Shivutz
# Twilio — international fallback / staging convenience
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── R19 §3 · Cloudinary folders (two paths, two envs) ───────
# Cloudinary sees ONE account across both envs — the folder is the
# only isolation between staging test uploads and prod user uploads.
# Wrong value on prod = production images land in the staging bucket
# and get wiped whenever staging is cleaned.
#
# R22 §2b: BOTH upload paths ship a folder var. Set both together, or
# the path you don't set silently uses its hard-coded default and
# your isolation is only half-real:
#
#   * CLOUDINARY_UPLOAD_FOLDER  → sponsor ads + housing photos + docs
#                                 (uploads.py:32, default 'tagidai/ads')
#   * CLOUDINARY_FOLDER_BASE    → marketplace listing images
#                                 (marketplace_uploads.py:35,
#                                 default 'shivutz/marketplace').
#                                 Per-advertiser sub-folders are
#                                 appended automatically.
#
# On staging prefix with 'staging/'; on prod use the plain names.
CLOUDINARY_UPLOAD_FOLDER=shivutz/staging
CLOUDINARY_FOLDER_BASE=shivutz/staging-marketplace

# ─── R19 §3 · Cron warning windows ───────────────────────
# How many days in advance the notification crons SMS users about
# an ad expiring or a trial ending. Longer window = more chances to
# renew, more SMS spend.
AD_EXPIRY_DAYS_AHEAD=7
TRIAL_ENDING_DAYS_AHEAD=3

# ─── R19 §3 · LLM tuning (search rewriter + reranker) ────
# See services/user-org/app/services/query_rewriter.py for the base
# defaults. Timeouts are in seconds; cache TTLs in seconds too.
LLM_RERANK_TIMEOUT_S=3.0
LLM_RERANK_CACHE_TTL=3600
LLM_REWRITER_CACHE_TTL=3600
LLM_REWRITER_SLOW_S=1.5

# ─── OTP dev bypass ──────────────────────────────────────
# Local + staging ONLY — auth service accepts this OTP for any phone.
# Never set in production.
MASTER_OTP=999999

# ─── Legacy job-match knobs (still read by user-org) ─────
JOB_DB_NAME=job_db
JOB_MATCH_SERVICE_URL=http://job-match:3004
MATCH_CACHE_TTL_SECONDS=60

# ─── Token encryption (WhatsApp opt-in tokens) ───────────
TOKEN_ENCRYPTION_KEY=

# ─── Smoke test — scripts/smoke_test.py ──────────────────
# S1 §1.2 — four seed phones the smoke test signs into. The four
# entities MUST have is_seed=TRUE (run scripts/mark_seed_entities.py
# once per env to flip the flag); the smoke test refuses to run
# otherwise. Never write real user phones here. Real values live in
# the operator's shell env (never in the repo).
CONTRACTOR_APPROVED_PHONE=
CONTRACTOR_PENDING_PHONE=
CONTRACTOR_B_PHONE=
CORPORATION_PHONE=
# S2 additions — --suite all (XSS + dual-entry direct-service)
ADMIN_PHONE=
USER_ORG_SERVICE_URL=
# R14 §1 — --suite matrix. Optional. When unset, the provider row in
# the R13 visibility matrix is SKIPped with an explicit reason. If
# set, must resolve to a service_provider seed row with is_seed=1 and
# an active entity_memberships row for the phone owner (register via
# /register/provider or seed inline). ADMIN_PHONE from above covers
# the admin row of the same matrix.
SERVICE_PROVIDER_PHONE=

# ─── Cloudinary (marketplace listing images + all image paths) ──
# Set on user-org. The ImageUploader on the listing form calls
# /marketplace/uploads/signature to get a signed upload set, then the
# browser POSTs the file directly to Cloudinary. Without these vars the
# signature endpoint returns 503 ("העלאת תמונות לא הופעלה") and the form
# shows the error inline — listings can still be published without
# images. Get the values from Cloudinary dashboard → Settings → Access
# Keys (free tier: 25 GB storage + 25 GB bandwidth/month).
# Folder isolation for both upload paths is documented in the block
# above (CLOUDINARY_UPLOAD_FOLDER + CLOUDINARY_FOLDER_BASE).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
