# ─── MySQL ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── RabbitMQ ────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SERVICE_JWT_SECRET=change_this_internal_service_secret

# ─── Auth Service ────────────────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_SERVICE_URL=http://auth:3001

# ─── User-Org Service ────────────────────────────────────
ORG_DB_NAME=org_db
USER_ORG_SERVICE_URL=http://user-org:3002

# ─── Worker Service ──────────────────────────────────────
WORKER_DB_NAME=worker_db
WORKER_SERVICE_URL=http://worker:3003

# ─── Deal Service ────────────────────────────────────────
DEAL_DB_NAME=deal_db
DEAL_SERVICE_URL=http://deal:3005

# ─── Notification Service ────────────────────────────────
NOTIF_DB_NAME=notif_db
NOTIFICATION_SERVICE_URL=http://notification:3006
SENDGRID_API_KEY=SG.changeme
SENDGRID_FROM_EMAIL=noreply@shivutz-platform.co.il
SENDGRID_FROM_NAME=Shivutz Platform

# ─── Admin Service ───────────────────────────────────────
ADMIN_SERVICE_URL=http://admin:3007

# ─── Gateway ─────────────────────────────────────────────
GATEWAY_PORT=3000
RATE_LIMIT_ANON=30
RATE_LIMIT_USER=200
RATE_LIMIT_ADMIN=500

# ─── Anthropic (query rewriter + reranker) ──────────────
# Missing key → user-org boots in fake mode (regex/keyword extractor).
# Container logs print `[qrewrite] mode=real ...` or `mode=fake reason=...`
# on startup — grep to confirm. LLM_REWRITER_FAKE_MODE=1 forces fake
# even when the key is set (useful for local dev / test).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_REWRITER_FAKE_MODE=
LLM_REWRITER_TIMEOUT_S=3.0
LLM_RERANK_ENABLED=1
LLM_RERANK_MIN=3
LLM_RERANK_TOP_N=20

# ─── ElevenLabs (voice search STT) ───────────────────────
# Track V — /api/voice/transcribe proxies audio to Scribe.
# Server-side only, NEVER expose to the client. Missing key → 503.
ELEVENLABS_API_KEY=

# ─── Cardcom (payments) ──────────────────────────────────
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
CARDCOM_BASE_URL=https://secure.cardcom.solutions
CARDCOM_TERMINAL_NUMBER=
CARDCOM_WEBHOOK_SECRET=

# ─── Vonage (SMS + WhatsApp) ─────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=Shivutz
VONAGE_SIGNATURE_SECRET=
SMS_PROVIDER=vonage

# ─── Payment service ─────────────────────────────────────
PAYMENT_DB_NAME=payment_db
PAYMENT_SERVICE_URL=http://payment:3009
# PAYMENT_FAKE_MODE=1 short-circuits Cardcom for local dev.
PAYMENT_FAKE_MODE=

# ─── Admin bootstrap ─────────────────────────────────────
# Email that seeds the first admin user on migration run.
ADMIN_EMAIL=admin@example.com

# ─── OTP dev bypass ──────────────────────────────────────
# Local + staging ONLY — auth service accepts this OTP for any phone.
# Never set in production.
MASTER_OTP=999999

# ─── Legacy job-match knobs (still read by user-org) ─────
JOB_DB_NAME=job_db
JOB_MATCH_SERVICE_URL=http://job-match:3004
MATCH_CACHE_TTL_SECONDS=60

# ─── Token encryption (WhatsApp opt-in tokens) ───────────
TOKEN_ENCRYPTION_KEY=

# ─── Cloudinary (marketplace listing images) ─────────────
# Set on user-org. The ImageUploader on the listing form calls
# /marketplace/uploads/signature to get a signed upload set, then the
# browser POSTs the file directly to Cloudinary. Without these vars the
# signature endpoint returns 503 ("העלאת תמונות לא הופעלה") and the form
# shows the error inline — listings can still be published without
# images. Get the values from Cloudinary dashboard → Settings → Access
# Keys (free tier: 25 GB storage + 25 GB bandwidth/month).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — defaults to "shivutz/marketplace". Per-advertiser sub-
# folders are appended automatically.
# CLOUDINARY_FOLDER_BASE=shivutz/marketplace
